{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LexianLix/manxia/main/plugins/manifest.schema.json",
  "title": "Manxia Plugin API 1",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "contributes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}\\.[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 1200
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "contributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "seed": {
              "$ref": "#/$defs/colorValue"
            },
            "lightSurface": {
              "$ref": "#/$defs/colorValue"
            },
            "darkSurface": {
              "$ref": "#/$defs/colorValue"
            }
          }
        },
        "reader": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "enum": [
                    "page",
                    "strip"
                  ]
                },
                {
                  "$ref": "#/$defs/reference"
                }
              ]
            },
            "rtl": {
              "$ref": "#/$defs/boolValue"
            },
            "doublePage": {
              "$ref": "#/$defs/boolValue"
            },
            "tapZones": {
              "$ref": "#/$defs/boolValue"
            },
            "background": {
              "anyOf": [
                {
                  "enum": [
                    "ink",
                    "paper",
                    "sepia"
                  ]
                },
                {
                  "$ref": "#/$defs/reference"
                }
              ]
            },
            "turn": {
              "anyOf": [
                {
                  "enum": [
                    "slide",
                    "paper"
                  ]
                },
                {
                  "$ref": "#/$defs/reference"
                }
              ]
            },
            "warmth": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.8
                },
                {
                  "$ref": "#/$defs/reference"
                }
              ]
            }
          }
        },
        "source": {
          "type": "object",
          "required": [
            "id",
            "name",
            "baseUrl",
            "cards",
            "title",
            "link",
            "cover",
            "chapters",
            "pages"
          ],
          "properties": {
            "baseUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "imageHosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "navigation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "allOf": [
            {
              "contains": {
                "const": 0
              }
            },
            {
              "contains": {
                "const": 3
              }
            }
          ]
        },
        "character": {
          "type": "object",
          "required": [
            "states"
          ],
          "additionalProperties": false,
          "properties": {
            "states": {
              "type": "object",
              "required": [
                "idle"
              ],
              "additionalProperties": false,
              "properties": {
                "idle": {
                  "$ref": "#/$defs/characterFrame"
                },
                "blink": {
                  "$ref": "#/$defs/characterFrame"
                },
                "happy": {
                  "$ref": "#/$defs/characterFrame"
                },
                "puzzled": {
                  "$ref": "#/$defs/characterFrame"
                }
              }
            }
          }
        }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "maxLength": 1200
            }
          }
        },
        "zh_TW": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "maxLength": 1200
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "setting"
      ],
      "additionalProperties": false,
      "properties": {
        "setting": {
          "type": "string"
        }
      }
    },
    "colorValue": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "boolValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "setting": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "boolean",
            "number",
            "choice",
            "color"
          ]
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "characterFrame": {
      "type": "object",
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,30}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
